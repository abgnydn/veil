{
  "compilerOptions": {
    "target": "es2022", "module": "preserve", "moduleResolution": "bundler",
    "lib": ["es2022"], "types": ["bun", "node"], "strict": true,
    "noUncheckedIndexedAccess": true, "allowImportingTsExtensions": true,
    "noEmit": true, "skipLibCheck": true, "verbatimModuleSyntax": true
  },
  "include": ["*.ts"]
}
